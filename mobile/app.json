{
  "expo": {
    "name": "MindCheck",
    "slug": "MindCheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_mindCheck.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "newArchEnabled": true,
    "android": {
      "package": "com.norapfr.mindcheck",
      "adaptiveIcon": {
        "backgroundColor": "#F8D7E3",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "react-native-fast-tflite",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "26ccdf3f-fa3b-4176-b832-a3dd3cee1371"
      }
    }
  }
}